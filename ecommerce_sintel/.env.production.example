# =============================================================================
# PLANTILLA .env.production -- sin secretos, sí versionable.
# Copiar a .env.production (gitignored) y completar los valores reales.
# Ver docs/deployment/ROADMAP_CLOUDFLARE_TUNNEL.md, Fase 16.
# =============================================================================

DJANGO_SETTINGS_MODULE=ecommerce.settings.production
SECRET_KEY=CHANGE_ME_generar_con_secrets_module_64_chars

DJANGO_SUPERUSER_EMAIL=admin@sintel.net.co
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_password_fuerte_12+_chars_mayus_minus_num_especial
DEBUG=False
ALLOWED_HOSTS=sintel.net.co,www.sintel.net.co,api.sintel.net.co,panel.sintel.net.co
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://sintel.net.co,https://www.sintel.net.co,https://api.sintel.net.co,https://panel.sintel.net.co

DB_NAME=sintel_ecommerce
DB_USER=sintel_prod
DB_PASSWORD=CHANGE_ME_password_fuerte
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
LOW_STOCK_THRESHOLD=5
JWT_SECRET_KEY=CHANGE_ME_generar_con_secrets_module_64_chars
CORS_ALLOWED_ORIGINS=https://sintel.net.co,https://www.sintel.net.co,https://panel.sintel.net.co

FRONTEND_BASE_URL=https://www.sintel.net.co

VITE_DEV_MODE=False

# ── Email Channel (SMTP) ──────────────────────────────────────────────────────
# EMAIL_USE_TLS (STARTTLS, tipico puerto 587) y EMAIL_USE_SSL (SSL implicito,
# tipico puerto 465) son mutuamente excluyentes -- dejar solo uno en True
# segun el puerto real del proveedor. En hosting compartido, EMAIL_HOST debe
# coincidir con el SNI del certificado real del servidor -- verificar con
# openssl s_client antes de asumir que un alias/CNAME de marca sirve, aunque
# resuelva bien por DNS. DEFAULT_FROM_EMAIL y SERVER_EMAIL deben ser siempre
# del dominio propio (nunca una direccion generica del servidor tipo
# usuario@servidor.com ni el default de Django root@localhost) -- afecta
# alineacion SPF/DKIM/DMARC en el receptor. Si el proyecto tiene un
# organization.EmailSettings en BD, ese valor tiene prioridad sobre este
# .env en los flujos reales de envio -- mantenerlo sincronizado.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@sintel.net.co
SERVER_EMAIL=noreply@sintel.net.co
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Meta Business (WhatsApp + Facebook + Instagram) ──────────────────────────
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret de la app de Meta (Panel de Meta for Developers > tu app >
# Configuracion basica). Usado por notifications/api/whatsapp_webhook.py
# para verificar X-Hub-Signature-256 en cada evento entrante -- FAIL-CLOSED:
# si esto queda vacio, el webhook rechaza TODOS los eventos entrantes (no es
# un fallback silencioso, es la proteccion contra el fallo F-01 ya corregido
# una vez para el webhook de Wompi). Obligatorio antes de registrar el
# webhook real en Meta Business Manager.
META_APP_SECRET=
# Token propio (no de Meta) que Django verifica contra el `hub.verify_token`
# que Meta envia al validar el webhook -- notifications/api/whatsapp_webhook.py.
# Pendiente configuracion real en Meta para produccion (ver ai_engine/.AGENT/
# FLIJO_COMPLETO_IA_ENGINE.md, Fase 7).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Meta Business: inventario de activos (FASE 1) ────────────────────────────
# IDs publicos de activos (no secretos), pero se manejan como el resto de la
# config de integracion: aqui, nunca en BD. Ver
# Documentacion/Arquitectura_general/META_BUSINESS_INTEGRATION_MASTER_PLAN.md.
# Version de Graph API que usa MetaGraphClient (marketing/integrations/meta/).
META_GRAPH_API_VERSION=v20.0
# Business Manager > Configuracion del negocio > Informacion del negocio.
META_BUSINESS_ID=
# WhatsApp Business Account ID -- Business Manager > Cuentas > Cuentas de WhatsApp.
# Necesario para plantillas y estados delivered/read (fases posteriores).
META_WABA_ID=
# Ad Account: Administrador de anuncios > Configuracion. SOLO el numero, sin "act_".
# Necesario a partir de la FASE 7 (Marketing READ API).
META_AD_ACCOUNT_ID=
# Opcionales, se agregan mas adelante (FASE 19 CAPI / FASE 20 catalogo):
META_CATALOG_ID=
META_PIXEL_ID=
META_DATASET_ID=

# ── AI Core (Sintel AI Engine) ───────────────────────────────────────────────
# [ACTUALIZADO 2026-08-17] sintel_ai SI esta en docker-compose.prod.yml desde
# la auditoria de puesta en produccion (privado, sin "ports", healthcheck real)
# -- pero AI_SUPPORT_CHAT_ENABLED sigue sin definir (default False) hasta una
# activacion explicita posterior. Proveedor LLM productivo: LM Studio Server
# (Windows HOST, API OpenAI-compatible, SIN Ollama) -- LOCAL_MODEL_CHAIN/
# EMBEDDING_* van hardcodeados directo en el "environment:" de ese servicio en
# docker-compose.prod.yml (no son secretos, no hace falta duplicarlos aqui).
# Ver ai_engine/.AGENT/LM_STUDIO_MIGRATION_2026-08-17.md para el detalle
# completo.
# AI_SUPPORT_CHAT_ENABLED=False
# AI_ENGINE_URL=http://sintel_ai:8100
# Fase 11 (Proactividad): slugs de NotificationTemplate que ademas disparan un
# mensaje proactivo del bot en la sala de soporte del cliente (Event Bus,
# Componente 8). Los 4 seed por notifications/migrations/0004_seed_proactive_templates.py
# + el cross-sell minimo seed por notifications/migrations/0005_seed_cross_sell_template.py:
# AI_PROACTIVE_SLUGS=cotizacion_sin_respuesta,renting_por_vencer,pago_rechazado_seguimiento,ticket_soporte_sin_seguimiento,cliente_recurrente_cross_sell

# ── Meta Ads MCP (FASE 10, ai_engine/mcp_client/) ────────────────────────────
# MCP oficial de Meta (https://mcp.facebook.com/ads). Credenciales OAuth
# INDEPENDIENTES de META_ACCESS_TOKEN -- el ai_engine nunca ve ese token.
# El MCP NO permite dynamic client registration (verificado contra el endpoint
# real 2026-08-31): hace falta un App de Meta. Su App ID = client_id OAuth
# (publico, PKCE S256, sin secret). Redirect URI a registrar en el App:
#   http://localhost:8766/callback
META_APP_ID=
# MCP_META_ADS_CLIENT_ID=   # opcional; si vacio usa META_APP_ID
# MCP_OAUTH_CALLBACK_PORT=8766
# Autorizar UNA vez (host, Docker Desktop -- sintel_prod_ai no publica puertos):
#   docker compose -f docker-compose.prod.yml run --rm -p 8766:8766 \
#       sintel_ai python -m mcp_client.authorize
# El refresh token se guarda en el volumen sintel_prod_mcp_tokens (/data/mcp).
# Solo despues de autorizar OK, poner esto en true:
# MCP_META_ADS_ENABLED=false
# FASE 10 es SOLO LECTURA -- no cambiar hasta FASE 16-18:
# MCP_META_ADS_ALLOW_WRITES=false

# ── YouTube (OAuth2) ─────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── TikTok (Content Posting API v2) ──────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=

# ── X / Twitter (API v2) ─────────────────────────────────────────────────────
X_BEARER_TOKEN=

# ── Google Business Profile ─────────────────────────────────────────────────
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_LOCATION_NAME=

# ── Marketing Intelligence Agent ─────────────────────────────────────────────
MARKETING_AGENT_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ── Wompi Colombia ─────────────────────────────────────────────────────────
# test = pagos deshabilitados (llaves pub_test_/prv_test_); production = llaves reales pub_prod_/prv_prod_
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_ENVIRONMENT=test

# ── Nequi Push Notification ──────────────────────────────────────────────────
NEQUI_CLIENT_ID=
NEQUI_CLIENT_SECRET=
NEQUI_API_KEY=
NEQUI_ENVIRONMENT=sandbox
